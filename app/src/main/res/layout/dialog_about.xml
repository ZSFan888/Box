<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_640"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_dialog_bg_main"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_title"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_30"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_15"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22" />

    <TextView
        android:id="@+id/updateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_15"
        android:lineSpacingExtra="@dimen/vs_5"
        android:text="@string/update_ready"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22" />

    <ProgressBar
        android:id="@+id/updateProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_8"
        android:layout_marginTop="@dimen/vs_20"
        android:max="100"
        android:progressTint="?attr/color_theme"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_25"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateClose"
            android:layout_width="@dimen/vs_150"
            android:layout_height="@dimen/vs_55"
            android:background="@drawable/button_dialog_main"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/update_close"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/updateAction"
            android:layout_width="@dimen/vs_200"
            android:layout_height="@dimen/vs_55"
            android:layout_marginStart="@dimen/vs_15"
            android:background="@drawable/button_dialog_main"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/update_check"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</LinearLayout>
